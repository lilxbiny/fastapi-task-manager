# ---- PostgreSQL ----
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpassword
POSTGRES_DB=taskdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full DSN used by SQLAlchemy (app connects to the "db" service name inside docker-compose)
DATABASE_URL=postgresql+psycopg2://taskuser:taskpassword@db:5432/taskdb

# ---- Security / JWT ----
# Generate a strong secret in production, e.g.: openssl rand -hex 32
SECRET_KEY=change_this_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
